{
  "name": "oyaku-founders-nursery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply oyaku-founders-orders --local",
    "dev": "npm run db:migrate:local && wrangler dev --port 8787",
    "test": "node --test test/*.test.mjs",
    "test:api": "node --test test/api.e2e.mjs",
    "test:browser": "node test/browser.e2e.mjs",
    "test:morning-flow": "node --test test/morning-flow.e2e.mjs",
    "test:admin": "node --test --test-concurrency=1 test/admin.e2e.mjs test/admin-guards.e2e.mjs",
    "test:admin-browser": "node test/admin-browser.e2e.mjs",
    "sandbox:form": "node scripts/sandbox-verify.mjs form",
    "sandbox:confirm": "node scripts/sandbox-verify.mjs confirm"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.40.0"
  }
}
